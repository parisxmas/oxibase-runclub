# ── Public (safe in the browser and in this repo) ────────────────────────────
# The OxiBase deployment and the project this app targets.
NEXT_PUBLIC_OXIBASE_URL=https://oxibase.baltavista.com
NEXT_PUBLIC_OXIBASE_REF=runclub

# The anon key: role "read", signed with the project's key. It is meant to ship
# in a browser — every write it can make is adjudicated by security rules, and
# it cannot write files or time-series at all.
NEXT_PUBLIC_OXIBASE_ANON_KEY=eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJyZWFkQGE4ZnB2ZDB4MXd5NW11ODQiLCJyb2xlIjoicmVhZCIsImlhdCI6MTc4NDkyODk3OSwiZXhwIjoyMTAwMjg4OTc5fQ.gzknsz0PQaKTlcxdSe72ULeakIbHF_sZj8dtOZZy_xT0Md78O8s2FBwfKF8_scj0PKXma6qMUk0lh5h7aQ5XEg

# ── Server only (never prefixed NEXT_PUBLIC_, never committed) ───────────────
# The service_role key bypasses rules. It is used by the route handlers for the
# two things a browser key deliberately cannot do: upload photos to storage and
# append points to the time-series engine. Set it in Vercel's env, not here.
OXIBASE_SERVICE_KEY=
